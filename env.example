# ─── Required ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Resend API key (starts with re_) — https://resend.com
RESEND_API_KEY=re_your_key_here

# Verified sender address at your Resend-verified domain
FROM_EMAIL=noreply@yourdomain.com

# Anthropic API key for Claude email/training generation
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Public URL of this deployment — use https:// in production
BASE_URL=http://localhost:5000

# ─── Optional ─────────────────────────────────────────────────────────────────
# SQLAlchemy DB URI — defaults to local SQLite, use PostgreSQL in production
# DATABASE_URL=postgresql://user:password@localhost:5432/phishguard

# Separate HMAC key for signing tracking tokens (recommended)
# SEND_ID_HMAC_SECRET=change-me-to-another-long-random-string

# Rate limiter backend — use Redis in multi-worker production deployments
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Set to 'production' to enable HTTPS enforcement and HSTS
# FLASK_ENV=production

# Stripe secret key for billing (leave unset to disable billing features)
# STRIPE_SECRET_KEY=sk_live_your_key_here
